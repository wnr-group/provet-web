// Prisma schema for Provet.
//
// Datasource: Postgres, hosted on Supabase. JSON-ish fields
// (Product.specifications, Product.images) are stored as plain strings
// (JSON-encoded) rather than a native Json column, and are parsed/serialized
// in lib/serializers.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  sku              String?   @unique
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  shortDescription String?
  composition      String?
  uses             String?
  dosage           String?
  applications     String?
  specifications   String? // JSON-encoded object, parsed/serialized in lib/serializers.js
  images           String? // JSON-encoded string array, parsed/serialized in lib/serializers.js
  packSize         String?
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  enquiries        Enquiry[]
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    String   @default("new") // "new" | "read" | "resolved"
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaText   String?
  ctaLink   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentBlock {
  id        String   @id @default(cuid())
  page      String
  key       String
  title     String?
  body      String?
  image     String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([page, key])
}

// Details captured before handing over the brochure download. Separate from
// Enquiry because Enquiry models a message staff must reply to and triage
// (subject/message, new -> read -> resolved), and has nowhere to put
// company/city; this is a one-shot download lead with no reply expected.
model BrochureLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String
  city      String?
  createdAt DateTime @default(now())
}
