# Database (SQLite for local dev; swap the adapter in lib/prisma.js + this URL
# to move to Postgres/Supabase in production)
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Uploads
MAX_UPLOAD_MB=5

# Brochure
# Returned as `file_url` by POST /api/brochure and used by the client as-is.
# Accepts a path served from public/ (default below) or a full external URL
# such as a CDN link. Leave unset to fall back to the bundled placeholder.
BROCHURE_FILE_URL=/brochure/provet-brochure.pdf

# SMTP / email notifications (server-side only - never exposed to the client).
# Enquiry emails are best-effort: when these are unset the enquiry is still
# saved and a clear "SMTP is not configured" warning is logged.
# SMTP_PORT 465 uses implicit TLS; 587 and 25 upgrade via STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address used for both the customer confirmation and the vendor
# notification, e.g. "Provet <no-reply@provet.in>".
SMTP_FROM=
# Where new-enquiry notifications are delivered. Server-side only: the
# customer can never influence this recipient.
VENDOR_EMAIL=
