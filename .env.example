# Database (SQLite for local dev; swap the adapter in lib/prisma.js + this URL
# to move to Postgres/Supabase in production)
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Uploads
MAX_UPLOAD_MB=5

# Brochure
# Returned as `file_url` by POST /api/brochure and used by the client as-is.
# Accepts a path served from public/ (default below) or a full external URL
# such as a CDN link. Leave unset to fall back to the bundled placeholder.
BROCHURE_FILE_URL=/brochure/provet-brochure.pdf
